# 异步驱动必须是 postgresql+asyncpg（不要用 postgresql+psycopg2）
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/DBNAME
# OpenRouter（推荐）：一套 key 同时用于 OpenAI 兼容协议与 Anthropic Messages
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4.6
# AGENT_LLM_MODEL=openai/gpt-4o-mini
# QUOTA_TRANSCRIPT_MODEL=openai/gpt-4o-mini

# 兼容回退：未配置 OPENROUTER_API_KEY 时仍可用官方直连
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

AGORA_CONVERSATIONAL_API_KEY=
AGORA_PROJECT_ID=
AGORA_APP_CERTIFICATE=
AGORA_CONVERSATIONAL_BASE_URL=
POLL_INTERVAL_SECONDS=5
MAX_CONCURRENT_CALLS=10
# Transcript-based quota: min confidence 0-1
QUOTA_TRANSCRIPT_MIN_CONFIDENCE=

# Case Study daily QC + prompt suggestions
# CASE_STUDY_TIMEZONE=Asia/Shanghai
# CASE_STUDY_RUN_HOUR=2
# CASE_STUDY_MIN_DURATION_SECONDS=30
# CASE_STUDY_QUALITY_THRESHOLD=0.8
# CASE_STUDY_MIN_EFFECTIVE_CALLS=3
# CASE_STUDY_AUDIO_QC_LIMIT=8
# CASE_STUDY_QC_MODEL=openai/gpt-4o-mini
# CASE_STUDY_AUDIO_MODEL=google/gemini-2.5-flash
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_PREFIX=

# Auth（JWT 签名密钥首次启动时自动生成，写入 data/jwt_hmac.key，不要写进配置）
JWT_EXPIRE_MINUTES=10080
# 启动时若不存在则自动创建 admin；ADMIN_PASSWORD 留空则随机生成并打印到日志
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=
# SMTP（填到 backend/.env，不要写进本文件；465/994 走 SSL，587 走 STARTTLS）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
